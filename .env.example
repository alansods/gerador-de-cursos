# Copie este arquivo para .env e preencha os valores.
# NUNCA coloque valores reais aqui: este arquivo é versionado.

# --- Obrigatórias ---

# PostgreSQL (Neon — https://neon.tech)
DATABASE_URL=""

# Chave de assinatura dos tokens JWT — gere com: openssl rand -base64 32
JWT_SECRET=""

# --- Geração de cursos por IA ---

# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# OpenAI (opcional, alternativa ao Gemini) — https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# --- Opcionais ---

# Upload de imagens via Vercel Blob — https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=""

# --- Colaboração em tempo real (Liveblocks, opcional) ---

# Liveblocks — https://liveblocks.io/dashboard/apikeys
# Sem a chave, o editor funciona normalmente e a camada de tempo real fica desligada.
# Local: use a chave sk_dev_. Produção: configure a sk_prod_ no painel da Vercel.
LIVEBLOCKS_SECRET_KEY=""

# Kill switch: só com "true" o editor tenta conectar ao Liveblocks.
# Limite de 2 pessoas por curso (plano gratuito) — ver src/lib/collab-config.ts
NEXT_PUBLIC_COLLAB_ENABLED="false"

# --- Usadas apenas durante o build SCORM (definidas pelo script, não pelo usuário) ---
# NEXT_OUTPUT_EXPORT=true
# SCORM_BUILD_CURSO_FILE=/caminho/para/curso.json
