# Copie este arquivo para .env.local e preencha os valores.
# NUNCA coloque valores reais aqui: este arquivo é versionado.

# --- Obrigatórias ---

# PostgreSQL (Neon, Supabase ou Vercel Postgres)
# Obtenha em: https://neon.tech
DATABASE_URL=""

# Chave de assinatura dos tokens JWT
# Gere com: openssl rand -base64 32
JWT_SECRET=""

# --- Geração de cursos por IA ---

# Google Gemini
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# OpenAI (opcional, alternativa ao Gemini)
# Obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# --- Opcionais ---

# Upload de imagens via Vercel Blob
# Obtenha em: https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=""

# URL pública da aplicação
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# --- Colaboração em tempo real (opcional) ---

# Liveblocks. Obtenha em: https://liveblocks.io/dashboard/apikeys
# Sem a chave, o editor funciona normalmente e a camada de tempo real fica desligada.
LIVEBLOCKS_SECRET_KEY=""

# Kill switch: só com "true" o editor tenta conectar ao Liveblocks.
# Limite de 2 pessoas por curso (plano gratuito) — ver src/lib/collab-config.ts
NEXT_PUBLIC_COLLAB_ENABLED="false"

# --- Usadas apenas durante o build SCORM (definidas pelo script, não pelo usuário) ---
# NEXT_OUTPUT_EXPORT=true
# SCORM_BUILD_CURSO_FILE=/caminho/para/curso.json
