// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER        @map("GESTOR")
  CONTENT_AUTHOR @map("CONTEUDISTA")
  REVIEWER       @map("REVISOR")
  GUEST          @map("CONVIDADO")

  @@map("RoleUsuario")
}

enum CourseStatus {
  IN_PROGRESS @map("EM_ANDAMENTO")
  IN_REVIEW   @map("EM_REVISAO")
  APPROVED    @map("APROVADO")
  REJECTED    @map("REPROVADO")

  @@map("StatusCurso")
}

enum CourseGenerationStatus {
  GENERATING
  COMPLETED
  FAILED

  @@map("course_generation_status")
}

enum AccessRequestStatus {
  PENDING  @map("PENDENTE")
  APPROVED @map("APROVADA")
  DENIED   @map("NEGADA")
  REVOKED  @map("REVOGADA")

  @@map("StatusSolicitacao")
}

// User account
model User {
  id                      String                @id @default(cuid())
  name                    String                @map("nome")
  role                    UserRole              @default(CONTENT_AUTHOR)
  email                   String                @unique
  password                String                @map("senha")
  createdAt               DateTime              @default(now()) @map("created_at")
  updatedAt               DateTime              @updatedAt @map("updated_at")
  activities              Activity[]
  courses                 Course[]              @relation("CourseOwner")
  reviewedCourses         Course[]              @relation("CourseReviewer")
  collaborations          CourseCollaborator[]  @relation("CollaborationUser")
  grantedCollaborations   CourseCollaborator[]  @relation("CollaborationGrantor")
  accessRequests          CourseAccessRequest[] @relation("AccessRequestRequester")
  respondedAccessRequests CourseAccessRequest[] @relation("AccessRequestResponder")
  comments                CourseComment[]       @relation("CommentAuthor")
  generationJobs          CourseGenerationJob[]

  @@index([email])
  @@index([role])
  @@map("users")
}

// Course, with the unit tree stored as JSON
model Course {
  id               String                  @id @default(cuid())
  title            String                  @map("titulo")
  slug             String?                 @unique
  description      String                  @map("descricao")
  workload         String                  @map("carga_horaria")
  modality         String                  @map("modalidade")
  category         String                  @map("categoria")
  layout           String                  @default("classic")
  bannerVideoUrl   String?                 @map("banner_video_url")
  units            Json                    @default("[]") @map("unidades")
  status           CourseStatus            @default(IN_PROGRESS)
  generationStatus CourseGenerationStatus? @map("generation_status")
  version          Int                     @default(0)
  ownerId          String?                 @map("owner_id")
  owner            User?                   @relation("CourseOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  reviewedById     String?                 @map("revisado_por_id")
  reviewedBy       User?                   @relation("CourseReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?               @map("revisado_em")
  createdAt        DateTime                @default(now()) @map("data_criacao")
  updatedAt        DateTime                @updatedAt @map("data_modificacao")
  collaborators    CourseCollaborator[]
  accessRequests   CourseAccessRequest[]
  comments         CourseComment[]
  generationJobs   CourseGenerationJob[]

  @@index([title])
  @@index([category])
  @@index([ownerId])
  @@index([status])
  @@map("cursos")
}

// Edit access granted on someone else's course
model CourseCollaborator {
  id          String   @id @default(cuid())
  courseId    String   @map("curso_id")
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId      String   @map("user_id")
  user        User     @relation("CollaborationUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedById String?  @map("concedido_por_id")
  grantedBy   User?    @relation("CollaborationGrantor", fields: [grantedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([courseId, userId])
  @@index([userId])
  @@map("curso_colaboradores")
}

// Request for edit access on someone else's course
model CourseAccessRequest {
  id            String              @id @default(cuid())
  courseId      String              @map("curso_id")
  course        Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  requesterId   String              @map("solicitante_id")
  requester     User                @relation("AccessRequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  status        AccessRequestStatus @default(PENDING)
  message       String?             @map("mensagem")
  respondedById String?             @map("respondido_por_id")
  respondedBy   User?               @relation("AccessRequestResponder", fields: [respondedById], references: [id], onDelete: SetNull)
  respondedAt   DateTime?           @map("respondido_em")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  @@unique([courseId, requesterId])
  @@index([status])
  @@index([requesterId])
  @@map("curso_access_requests")
}

// Single review thread per course
model CourseComment {
  id        String   @id @default(cuid())
  courseId  String   @map("curso_id")
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  authorId  String   @map("autor_id")
  author    User     @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  text      String   @map("texto")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([courseId, createdAt])
  @@map("curso_comentarios")
}

// Activity log
model Activity {
  id          String   @id @default(cuid())
  type        String   @map("tipo") // 'course_created', 'course_updated', 'course_deleted', 'user_created', 'user_updated', 'user_deleted'
  title       String   @map("titulo") // human-readable activity title
  description String?  @map("descricao") // extra detail, such as the course or user name
  entityId    String?  @map("entity_id") // affected entity id
  entityType  String?  @map("entity_type") // 'course' or 'user'
  userId      String?  @map("user_id") // user who performed the action
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([type])
  @@index([createdAt])
  @@index([userId])
  @@map("activities")
}

// SCORM export job queue
model SCORMJob {
  id          String    @id @default(cuid())
  courseId    String    @map("curso_id")
  courseTitle String    @map("curso_titulo")
  status      String // 'pending', 'building', 'completed', 'failed'
  progress    String? // current progress message
  error       String? // error message when it fails
  zipData     Bytes?    @map("zip_data") // ZIP payload once completed
  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  @@index([status])
  @@index([createdAt])
  @@index([courseId])
  @@map("scorm_jobs")
}

model CourseGenerationJob {
  id               String                 @id @default(cuid())
  courseId         String                 @map("course_id")
  course           Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId           String                 @map("user_id")
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  status           CourseGenerationStatus @default(GENERATING)
  sourceFileName   String                 @map("source_file_name")
  sourceText       String                 @map("source_text")
  layout           String?
  mode             String
  error            String?
  model            String?
  promptTokens     Int?                   @map("prompt_tokens")
  completionTokens Int?                   @map("completion_tokens")
  startedAt        DateTime               @default(now()) @map("started_at")
  finishedAt       DateTime?              @map("finished_at")
  notifiedAt       DateTime?              @map("notified_at")

  @@index([userId, status])
  @@index([courseId])
  @@map("course_generation_jobs")
}
