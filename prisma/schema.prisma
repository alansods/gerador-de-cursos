// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER        @map("GESTOR")
  CONTENT_AUTHOR @map("CONTEUDISTA")
  REVIEWER       @map("REVISOR")
  GUEST          @map("CONVIDADO")

  @@map("RoleUsuario")
}

enum CourseStatus {
  IN_PROGRESS @map("EM_ANDAMENTO")
  IN_REVIEW   @map("EM_REVISAO")
  APPROVED    @map("APROVADO")
  REJECTED    @map("REPROVADO")

  @@map("StatusCurso")
}

enum AccessRequestStatus {
  PENDING  @map("PENDENTE")
  APPROVED @map("APROVADA")
  DENIED   @map("NEGADA")
  REVOKED  @map("REVOGADA")

  @@map("StatusSolicitacao")
}

// Modelo de Usuário
model User {
  id                      String                @id @default(cuid())
  name                    String                @map("nome")
  role                    UserRole              @default(CONTENT_AUTHOR)
  email                   String                @unique
  password                String                @map("senha")
  createdAt               DateTime              @default(now()) @map("created_at")
  updatedAt               DateTime              @updatedAt @map("updated_at")
  activities              Activity[]
  courses                 Course[]              @relation("CourseOwner")
  reviewedCourses         Course[]              @relation("CourseReviewer")
  collaborations          CourseCollaborator[]  @relation("CollaborationUser")
  grantedCollaborations   CourseCollaborator[]  @relation("CollaborationGrantor")
  accessRequests          CourseAccessRequest[] @relation("AccessRequestRequester")
  respondedAccessRequests CourseAccessRequest[] @relation("AccessRequestResponder")
  comments                CourseComment[]       @relation("CommentAuthor")

  @@index([email])
  @@index([role])
  @@map("users")
}

// Modelo de Cursos (adaptado do sistema existente)
model Course {
  id             String                @id @default(cuid())
  title          String                @map("titulo")
  slug           String?               @unique
  description    String                @map("descricao")
  workload       String                @map("carga_horaria")
  modality       String                @map("modalidade")
  category       String                @map("categoria")
  layout         String                @default("classico")
  bannerVideoUrl String?               @map("banner_video_url")
  units          Json                  @default("[]") @map("unidades")
  status         CourseStatus          @default(IN_PROGRESS)
  version        Int                   @default(0)
  ownerId        String?               @map("owner_id")
  owner          User?                 @relation("CourseOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  reviewedById   String?               @map("revisado_por_id")
  reviewedBy     User?                 @relation("CourseReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?             @map("revisado_em")
  createdAt      DateTime              @default(now()) @map("data_criacao")
  updatedAt      DateTime              @updatedAt @map("data_modificacao")
  collaborators  CourseCollaborator[]
  accessRequests CourseAccessRequest[]
  comments       CourseComment[]

  @@index([title])
  @@index([category])
  @@index([ownerId])
  @@index([status])
  @@map("cursos")
}

// Acesso concedido a um curso de terceiro
model CourseCollaborator {
  id          String   @id @default(cuid())
  courseId    String   @map("curso_id")
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId      String   @map("user_id")
  user        User     @relation("CollaborationUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedById String?  @map("concedido_por_id")
  grantedBy   User?    @relation("CollaborationGrantor", fields: [grantedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([courseId, userId])
  @@index([userId])
  @@map("curso_colaboradores")
}

// Pedido de acesso a um curso de terceiro
model CourseAccessRequest {
  id            String              @id @default(cuid())
  courseId      String              @map("curso_id")
  course        Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  requesterId   String              @map("solicitante_id")
  requester     User                @relation("AccessRequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  status        AccessRequestStatus @default(PENDING)
  message       String?             @map("mensagem")
  respondedById String?             @map("respondido_por_id")
  respondedBy   User?               @relation("AccessRequestResponder", fields: [respondedById], references: [id], onDelete: SetNull)
  respondedAt   DateTime?           @map("respondido_em")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  @@unique([courseId, requesterId])
  @@index([status])
  @@index([requesterId])
  @@map("curso_access_requests")
}

// Thread única de comentários por curso
model CourseComment {
  id        String   @id @default(cuid())
  courseId  String   @map("curso_id")
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  authorId  String   @map("autor_id")
  author    User     @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  text      String   @map("texto")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([courseId, createdAt])
  @@map("curso_comentarios")
}

// Modelo de Atividades (log de ações dos usuários)
model Activity {
  id          String   @id @default(cuid())
  type        String   @map("tipo") // 'curso_criado', 'curso_editado', 'curso_deletado', 'usuario_criado', 'usuario_editado', 'usuario_deletado'
  title       String   @map("titulo") // título descritivo da atividade
  description String?  @map("descricao") // descrição adicional (ex: nome do curso ou usuário)
  entityId    String?  @map("entity_id") // ID da entidade afetada (curso ou usuário)
  entityType  String?  @map("entity_type") // 'curso' ou 'usuario'
  userId      String?  @map("user_id") // ID do usuário que realizou a ação
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([type])
  @@index([createdAt])
  @@index([userId])
  @@map("activities")
}

// Modelo de Jobs de Geração SCORM
model SCORMJob {
  id          String    @id @default(cuid())
  courseId    String    @map("curso_id")
  courseTitle String    @map("curso_titulo")
  status      String // 'pending', 'building', 'completed', 'failed'
  progress    String? // mensagem de progresso atual
  error       String? // mensagem de erro se falhar
  zipData     Bytes?    @map("zip_data") // dados do ZIP (Buffer) quando completado
  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  @@index([status])
  @@index([createdAt])
  @@index([courseId])
  @@map("scorm_jobs")
}
